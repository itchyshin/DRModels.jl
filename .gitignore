# Local preview helper (Claude_Preview launch config) — not part of the package.
/.claude/launch.json

# Subagent worktrees (created by the Agent tool; never commit).
/.claude/worktrees/

# Local git worktrees under the repo (D-111 / lane fence — never stage).
/.worktrees/

